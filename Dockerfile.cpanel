# Dockerfile Simulasi 1-Slot cPanel Node.js App (Master Gateway app.js)
FROM node:22-alpine AS builder
RUN apk add --no-cache openssl

WORKDIR /app

# 1. Install Master Gateway dependencies
COPY package-master.json ./package.json
RUN npm install

# 2. Build NestJS Backend
COPY nest-backend-boilerplate ./backend
WORKDIR /app/backend
RUN npm install --ignore-scripts
RUN npx prisma generate
RUN npm run build

# 3. Build Next.js Frontend (Standalone)
WORKDIR /app
COPY next-frontend-boilerplate ./frontend
WORKDIR /app/frontend
RUN npm install --ignore-scripts
RUN npm run build

# 4. Copy Master & Helper Scripts
WORKDIR /app
COPY app.js ./app.js
COPY server-cpanel.js ./server-cpanel.js

# Runner Stage
FROM node:22-alpine AS runner
RUN apk add --no-cache openssl
WORKDIR /app

# Master Gateway
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/app.js ./app.js

# Backend
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/node_modules ./backend/node_modules
COPY --from=builder /app/backend/package*.json ./backend/
COPY --from=builder /app/backend/prisma ./backend/prisma

# Frontend Standalone + Static Assets + server-cpanel.js
COPY --from=builder /app/frontend/.next/standalone ./frontend
COPY --from=builder /app/frontend/public ./frontend/public
COPY --from=builder /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder /app/server-cpanel.js ./frontend/server-cpanel.js

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "app.js"]
