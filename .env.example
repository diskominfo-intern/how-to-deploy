# ==========================================================
# ENVIRONMENT VARIABLES TEMPLATE (CPANEL & DOCKER DEPLOYMENT)
# ==========================================================

# 1. System Configuration
NODE_ENV=production
# PORT=3000

# 2. Backend Configuration (NestJS)
DATABASE_URL="mysql://db_user:db_password@localhost:3306/db_name"
JWT_SECRET="ganti-dengan-jwt-secret-key-yang-sangat-rahasia"

# 3. Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL="/api"

# 4. (Opsional) Internal Ports Override
# Master Gateway (app.js) secara default otomatis mencari port kosong (Dynamic Free Port) dari OS.
# Anda TIDAK PERLU mengisi variabel di bawah kecuali ingin menentukan port spesifik:
# FRONTEND_PORT=39001
# BACKEND_PORT=39002
